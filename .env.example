# Copy to .env for local configuration. Defaults work without AWS credentials.
AGENT_PROVIDER=fixture
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
AGENT_DATA_DIR=.local/agent
AWS_PROFILE=nba
AWS_REGION=us-east-1
ALLOW_PAID_MODEL_CALLS=false
# Set only after authorization AND live model access/quota/region verification.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# Optional externally installed FFmpeg. Otherwise uses the pinned npm package binary.
FFMPEG_PATH=
