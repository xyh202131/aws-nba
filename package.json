{
  "name": "courtside-deep-court",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/build-public-readme.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "postbuild": "node scripts/prune-retired-demo-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit && tsc -p tsconfig.agent.json",
    "agent": "node --env-file-if-exists=.env --experimental-strip-types agent/server.ts",
    "infra:synth": "node --experimental-strip-types infra/app.ts",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1148.0",
    "@aws-sdk/client-polly": "3.1148.0",
    "@aws-sdk/client-s3": "3.1148.0",
    "@aws-sdk/client-sts": "3.1148.0",
    "@aws-sdk/credential-providers": "3.1148.0",
    "ffmpeg-static": "5.3.0",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1",
    "prettier": "^3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
